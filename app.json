{
  "expo": {
    "name": "selfFire",
    "slug": "selfFire",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/fire-icon.png",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.changsunoh.selfFire"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/fire-adaptive-icon.png",
        "backgroundColor": "#1A1A1A"
      },
      "package": "com.changsunoh.selfFire",
      "versionCode": 2,
      "permissions": [
        "SYSTEM_ALERT_WINDOW",
        "RECEIVE_BOOT_COMPLETED",
        "SCHEDULE_EXACT_ALARM"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/fire-splash.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#1A1A1A"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/fire-icon.png",
          "color": "#FF6B35",
          "defaultChannel": "default"
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-3739053005473702~4826603652",
          "iosAppId": "ca-app-pub-xxxxxxxx~xxxxxxxx"
        }
      ],
      "expo-font",
      "expo-web-browser",
      "./plugins/withAutoLaunch.js"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f0790d9d-0a6d-4a87-9226-6a3a6d0b3832"
      }
    }
  }
}