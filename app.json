{
  "expo": {
    "name": "selfFire",
    "slug": "selfFire",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/fire-icon.png",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.changsunoh.selfFire"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/fire-adaptive-icon.png",
        "backgroundColor": "#1A1A1A"
      },
      "package": "com.changsunoh.selfFire",
      "versionCode": 2,
      "permissions": [
        "SYSTEM_ALERT_WINDOW",
        "RECEIVE_BOOT_COMPLETED",
        "SCHEDULE_EXACT_ALARM"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/fire-splash.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#1A1A1A"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/fire-icon.png",
          "color": "#FF6B35",
          "defaultChannel": "default"
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-3739053005473702~4826603652",
          "iosAppId": "ca-app-pub-xxxxxxxx~xxxxxxxx"
        }
      ],
      "expo-font",
      "expo-web-browser",
      "./plugins/withAutoLaunch.js",
      [
        "react-native-android-widget",
        {
          "fonts": [
            "./node_modules/@expo-google-fonts/nanum-myeongjo/700Bold/NanumMyeongjo_700Bold.ttf"
          ],
          "widgets": [
            {
              "name": "Quote",
              "label": "오늘의 명언",
              "description": "오늘의 명언과 불씨 상태를 보여 줍니다",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "Flame",
              "label": "불씨",
              "description": "불씨를 이어 온 날과 오늘 점화 여부를 보여 줍니다",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f0790d9d-0a6d-4a87-9226-6a3a6d0b3832"
      }
    }
  }
}